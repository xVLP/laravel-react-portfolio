APP_NAME="Veronica Louise Piando (xVLP) Portfolio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# ==========================================
# DATABASE CONFIGURATION PRESETS
# ==========================================

# OPTION 1: SQLite (Default Local / Zero-Config File Database)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# OPTION 2: Supabase (Recommended Free Hosted Cloud PostgreSQL)
# Get your connection details from Supabase Project Settings -> Database:
# DB_CONNECTION=pgsql
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=6543
# DB_DATABASE=postgres
# DB_USERNAME=postgres.your_project_id
# DB_PASSWORD=your_supabase_db_password

# OPTION 3: MySQL (Railway, Render, Aiven, or Local MySQL)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=portfolio
# DB_USERNAME=root
# DB_PASSWORD=secret
